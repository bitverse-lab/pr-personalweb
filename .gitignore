# dependencies
/node_modules
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local env files (any variant) - only the .example template is committed
.env
.env.*
!.env.local.example

# editor / tool state
.claude/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# third-party purchased template used only as a visual reference (licence: do not redistribute)
/Fronter_ReactJs/
/fronter-react-js-multipurpose-landing-template-*/

# throwaway files
*.log
.DS_Store
Thumbs.db
