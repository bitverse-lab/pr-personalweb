# Supabase Dashboard > Project Settings > Database > Connection Pooling tab (Transaction mode, port 6543)
DATABASE_URL=

# Same page > "Connect" dialog > Session pooler, port 5432 (used only for migrations).
# Use the Session pooler, NOT the raw "Direct connection" host — that one only resolves
# over IPv6, which fails on IPv4-only networks.
DIRECT_URL=

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web application)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Base URL of the app. `pnpm dev` runs on port 3000; if you use another port, change it here and in the Google redirect URI.
AUTH_URL=http://localhost:3000

# The only Google account allowed to sign in to /me
OWNER_EMAIL=

# Supabase Storage (uploads). Dashboard > Project Settings > API.
# SUPABASE_URL is the Project URL; the service-role key is SECRET - server only, never commit or share it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the deployed site (used for sitemap/robots/social links). Defaults to AUTH_URL.
SITE_URL=

# Contact form email (optional). Without these, messages still land in your /me inbox.
# Resend: create a free account, verify a sender, and paste the API key (it is a secret; server only).
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=

# Optional visitor statistics for the public site (cookie-free). Use ONE of the two; nothing loads if both are empty,
# and it never runs in development or inside /me. These are public values, not secrets.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
